{
  "role": "manager",
  "listen": "127.0.0.1:8080",
  "worker_transport_listen": "0.0.0.0:9443",
  "manager_data_dir": "./state/manager",
  "manager_identity_dir": "./state/manager-identity",
  "manager_server_name": "localhost",
  "worker_id": "worker-one",
  "worker_transport_capacity": 2,
  "worker_resource_domain_id": "local-host",
  "worker_service_network": {
    "network_domain_id": "local-host-network",
    "port_range_start": 31000,
    "port_range_end": 31999,
    "advertised_address": "192.0.2.10"
  },
  "host_resource_domains": [
    { "id": "local-host", "cpu_millis": 1000, "memory_bytes": 1073741824 }
  ],
  "additional_workers": [
    {
      "worker_id": "worker-two",
      "capacity": 2,
      "resource_domain_id": "local-host",
      "service_network": {
        "network_domain_id": "local-host-network",
        "port_range_start": 32000,
        "port_range_end": 32999,
        "advertised_address": "192.0.2.10"
      }
    }
  ],
  "api_access": {
    "mode": "local"
  }
}
